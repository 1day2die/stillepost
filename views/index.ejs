<!DOCTYPE html>
<html lang="<%= getLocale() %>">
<head>

    <!-- Basic Page Needs
  ================================================== -->
    <meta charset="utf-8">
    <title>stille post</title>
    <meta name="description" content="">
    <meta name="author" content="">
    <meta name="referrer" content="no-referrer">

    <!-- Mobile Specific Metas
  ================================================== -->
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- CSS
  ================================================== -->
    <link rel="stylesheet" href="stylesheets/base.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="stylesheets/skeleton.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="stylesheets/layout.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="stylesheets/style.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="stylesheets/share.css?v=<%= assetVersion %>">

    <!-- Favicons
    ================================================== -->
    <link rel="shortcut icon" href="images/favicon.ico">
    <link rel="apple-touch-icon" href="images/apple-touch-icon.png">
    <link rel="apple-touch-icon" sizes="72x72" href="images/apple-touch-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="114x114" href="images/apple-touch-icon-114x114.png">

    <script src="javascripts/stillepost.js?v=<%= assetVersion %>" defer></script>

</head>
<body>

<!-- Primary Page Layout
================================================== -->

<div class="container">
    <div class="sixteen columns">
        <h1 class="title">Stille POST</h1>
        <div class="subtitle">Sicher. Lokal. Einfach</div>
    </div>

    <div class="sixteen columns"
         id="app"
         data-api="api/entries"
         data-msg-no-entry="<%= __('No entry found!') %> <%= __('Either there is no such key or your entry has already been accessed by another one.') %>"
         data-msg-create-failed="<%= __('Something went wrong. Please try again.') %>"
         data-msg-decrypt-failed="<%= __('The entry could not be decrypted. The link is incomplete or damaged.') %>"
         data-msg-too-long="<%= __('The entry is too long.') %>"
         data-msg-crypto-unavailable="<%= __('This browser cannot encrypt. Please use an up to date browser over https.') %>"
         data-msg-invalid-views="<%= __('Please enter a number between 1 and 20.') %>"
         data-msg-validity-one="<%= __('The link can be opened once and expires after {{hours}} hours.', { hours: entryTtlHours }) %>"
         data-msg-validity-many="<%= __('The link can be opened {n} times and expires after {{hours}} hours.', { hours: entryTtlHours }) %>"
         data-msg-views-left-one="<%= __('This entry can be opened one more time after this one.') %>"
         data-msg-views-left-many="<%= __('This entry can be opened {n} more times after this one.') %>"
         data-msg-views-last="<%= __('This is the last access, the entry will be deleted.') %>"
         data-msg-revealed-left-one="<%= __('The entry can be opened one more time.') %>"
         data-msg-revealed-left-many="<%= __('The entry can be opened {n} more times.') %>"
         data-msg-deleted-now="<%= __('Do not reload! Your entry has been deleted already.') %>">

        <noscript>
            <p><strong><%= __('This service needs JavaScript, because your entry is encrypted in your browser before it is sent.') %></strong></p>
        </noscript>

        <p id="error" class="error" hidden></p>

        <!-- create a new entry -->
        <section id="view-create" hidden>
            <form id="create-form" autocomplete="off">
                <div id="create-fields">
                    <label for="secretUserMessage"><%= __('Text (password, secret, etc.):') %></label>
                    <textarea class="field" id="secretUserMessage" name="secretUserMessage"></textarea>
                    <div id="counter" class="counter"></div>
                    <div class="views-row">
                        <label for="views"><%= __('How many times may the link be opened?') %></label>
                        <input type="number" id="views" name="views" value="1" min="1" max="20" step="1" class="views-input">
                    </div>
                    <button type="submit" id="create-button"><%= __('Create link') %></button>
                </div>
            </form>

            <div id="result" hidden>
                <label for="url"><%= __('The entry is available at this URL:') %></label>
                <p id="views-note" class="views-note"></p>
                <input class="wide" type="text" id="url" name="url" readonly/>
                <div class="checkbox-label">
                    <input type="checkbox" id="copydelete" name="copydelete" value="true" checked>
                    <label class="checkbox-label" for="copydelete"><%= __('Nach dem Kopieren Eingabe leeren') %></label>
                </div>
                <br/>
                <button type="button" class="copy" id="copy"><%= __('copy') %></button>
                <button type="button" class="share-button whatsapp" id="share-whatsapp"><%= __('Sende via Whatsapp') %></button>
                <button type="button" class="share-button telegram" id="share-telegram"><%= __('Sende via Telegram') %></button>
                <button type="button" class="share-button threema" id="share-threema"><%= __('Sende via Threema') %></button>
            </div>
        </section>

        <!-- read an entry -->
        <section id="view-read" hidden>
            <div id="reveal" hidden>
                <p id="reveal-note"><%= __('You can access the secret message now. Please note that the message will be deleted!') %></p>
                <button type="button" id="reveal-button"><%= __('Show secret') %></button>
            </div>

            <div id="revealed" hidden>
                <label for="result-text"><%= __('The entry:') %></label>
                <textarea class="field" id="result-text" readonly></textarea>
                <p id="revealed-note"><em><%= __('Do not reload! Your entry has been deleted already.') %></em></p>
                <a href="./"><button type="button"><%= __('Create new link') %></button></a>
            </div>
        </section>
    </div>

    <div class="sixteen columns">
        <h5 id="faq" class="faq-toggle"><a href="#">INFO</a></h5>
    </div>
    <div id="faqContainer" hidden>
        <div class="sixteen columns"><h6><%= __('HOW-TO-TITLE') %></h6><p><%= __('HOW-TO-MESSAGE', { hours: entryTtlHours }) %></p></div>
        <div class="sixteen columns"><h6><%= __('What is it all about?') %></h6><p><%= __('Sending secrets by email has some problems. First, the email is sent in clear text, everybody who can read the transmission can read the secret, second the email is stored in the email account of the sender and the recipient! read2burn.com enables a secure transmission by storing the secret encrypted and creating an access url that is valid only once. Therefore a manipulation by others will be recognized.') %></p></div>
        <div class="sixteen columns"><h6><%= __('Hints') %></h6><p><%= __('Never encrypt login and password together.') %><br/><%= __('Send login and password always separately.') %></p></div>
        <div class="sixteen columns"><h6><%= __('Your data is safe!') %></h6><p><%= __('Stille Post is end-to-end encrypted. Your entry is encrypted in your browser with AES-256-GCM before anything is sent. The key exists only in the part of the link after the # sign, and browsers never transmit that part to a server. What is stored is therefore ciphertext that neither the operator nor anyone with access to the database, the backups or the logs can read. The entry is deleted as soon as it has been opened as often as you allowed, and after {{hours}} hours at the latest.', { hours: entryTtlHours }) %></p></div>
        <div class="sixteen columns"><h6><p> Dies ist eine OpenSource software von WeMove. Der Code wurde angepasst um Tracker zu entfernen</p></div>
    </div>
</div><!-- container -->

<!-- End Document
================================================== -->

</body>
</html>
